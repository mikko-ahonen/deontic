{
  "$schema": "dictionary.schema.json",
  "name": "museum",
  "version": "1",
  "description": "Fixture lexicon for the conformance corpus. Invented and deliberately dull: it exists so that every construct of the language can be exercised once, not to model any real domain. It conforms to dictionary.schema.json; the meaning of each verb is stated in prose under 'means' so that an implementer can reproduce the evaluate/ cases.",
  "strictness": "permissive",
  "types": {
    "exhibit": {
      "plural": "exhibits",
      "fields": {
        "title": "text",
        "status": "text",
        "acquired on": "date",
        "value": "number",
        "condition score": "number",
        "gallery": {
          "kind": "reference",
          "to": "gallery"
        },
        "lender": {
          "kind": "reference",
          "to": "lender"
        }
      },
      "tags": [
        "fragile",
        "featured",
        "draft",
        "on-loan",
        "insured",
        "photographed"
      ]
    },
    "gallery": {
      "plural": "galleries",
      "fields": {
        "name": "text",
        "floor": "number",
        "capacity": "number",
        "status": "text"
      },
      "tags": [
        "public",
        "storage"
      ]
    },
    "curator": {
      "plural": "curators",
      "fields": {
        "name": "text",
        "status": "text",
        "hired on": "date",
        "department": {
          "kind": "reference",
          "to": "department"
        }
      },
      "tags": [
        "senior",
        "remote"
      ]
    },
    "department": {
      "plural": "departments",
      "fields": {
        "name": "text"
      }
    },
    "lender": {
      "plural": "lenders",
      "fields": {
        "name": "text",
        "status": "text",
        "type": "text",
        "country": "text",
        "verified": "boolean"
      }
    },
    "loan": {
      "plural": "loans",
      "fields": {
        "exhibit": {
          "kind": "reference",
          "to": "exhibit"
        },
        "lender": {
          "kind": "reference",
          "to": "lender"
        },
        "approver": {
          "kind": "reference",
          "to": "curator"
        },
        "requester": {
          "kind": "reference",
          "to": "curator"
        },
        "starts on": "date",
        "due on": "date",
        "returned on": "date",
        "status": "text"
      },
      "tags": [
        "overdue"
      ]
    },
    "reminder": {
      "plural": "reminders",
      "fields": {
        "loan": {
          "kind": "reference",
          "to": "loan"
        },
        "sent on": "date"
      }
    },
    "inspection": {
      "plural": "inspections",
      "fields": {
        "gallery": {
          "kind": "reference",
          "to": "gallery"
        },
        "inspector": {
          "kind": "reference",
          "to": "curator"
        },
        "inspected on": "date",
        "result": "text"
      }
    },
    "course": {
      "plural": "courses",
      "fields": {
        "title": "text"
      },
      "tags": [
        "mandatory",
        "safety",
        "remote"
      ]
    },
    "completion": {
      "plural": "completions",
      "fields": {
        "curator": {
          "kind": "reference",
          "to": "curator"
        },
        "course": {
          "kind": "reference",
          "to": "course"
        },
        "completed on": "date"
      }
    },
    "catalogue entry": {
      "plural": "catalogue entries",
      "fields": {
        "exhibit": {
          "kind": "reference",
          "to": "exhibit"
        },
        "published on": "date",
        "status": "text"
      },
      "tags": [
        "draft"
      ]
    },
    "policy document": {
      "plural": "policy documents",
      "fields": {
        "title": "text",
        "status": "text",
        "effective on": "date",
        "version": "number"
      }
    },
    "report": {
      "plural": "reports",
      "fields": {
        "title": "text",
        "author": {
          "kind": "reference",
          "to": "curator"
        },
        "published on": "date"
      },
      "tags": [
        "collection"
      ]
    },
    "device": {
      "plural": "devices",
      "fields": {
        "name": "text",
        "status": "text"
      }
    },
    "reading": {
      "plural": "readings",
      "fields": {
        "gallery": {
          "kind": "reference",
          "to": "gallery"
        },
        "device": {
          "kind": "reference",
          "to": "device"
        },
        "measured on": "date",
        "humidity": "number",
        "available": "boolean"
      }
    }
  },
  "verbs": {
    "exist": {
      "object": "none",
      "description": "core; the existence shape"
    },
    "have": {
      "object": "entity",
      "description": "the subject has the object: either a field of the subject declared as a reference to the object's type is set (to any entity matching the object's filter), or an entity of the object's type exists whose reference field of the subject's type points at the subject"
    },
    "have completed": {
      "synonyms": [
        "complete"
      ],
      "subject": "curator",
      "object": "course",
      "description": "a completion exists whose curator is the subject and whose course matches the object; with a time expression, its 'completed on' falls in the window"
    },
    "be located in": {
      "subject": "exhibit",
      "object": "gallery",
      "description": "the subject's gallery matches the object"
    },
    "be lent to": {
      "subject": "exhibit",
      "object": "lender",
      "description": "a loan exists whose exhibit is the subject, whose lender matches the object, and whose 'returned on' is empty"
    },
    "be returned": {
      "subject": "loan",
      "object": "none",
      "description": "the subject's 'returned on' is set; with an anchored time expression, it falls in the window relative to the anchor"
    },
    "be inspected": {
      "subject": "gallery",
      "object": "none",
      "description": "an inspection exists whose gallery is the subject; with a time expression, its 'inspected on' falls in the window"
    },
    "publish": {
      "subject": "curator",
      "object": "report",
      "description": "a report exists whose author is the subject and which matches the object; with a period, one such report per period"
    },
    "review": {
      "subject": "curator",
      "object": "entity",
      "description": "declared for the cadence shape; its evaluation is not exercised by the corpus"
    },
    "approve": {
      "subject": "curator",
      "object": "loan",
      "description": "a loan matching the object exists whose approver is the subject"
    },
    "be assigned to": {
      "subject": "curator",
      "object": "gallery",
      "description": "declared for the aggregate count shape; its evaluation is not exercised by the corpus"
    }
  },
  "events": {
    "Acquisition": {
      "type": "exhibit",
      "field": "acquired on"
    },
    "Loan Start": {
      "type": "loan",
      "field": "starts on"
    },
    "Due Date": {
      "type": "loan",
      "field": "due on"
    },
    "Return": {
      "type": "loan",
      "field": "returned on"
    }
  },
  "cadences": {
    "Inspection Period": {
      "value": 6,
      "unit": "month"
    }
  },
  "metrics": {
    "Humidity": {
      "of": "gallery",
      "unit": "percent",
      "description": "the mean of 'humidity' over the readings whose gallery is the subject and whose 'measured on' falls in the window"
    },
    "Condition Score": {
      "of": "exhibit",
      "description": "the subject's 'condition score' field"
    },
    "Availability": {
      "of": "device",
      "unit": "percent",
      "description": "the share of readings whose device is the subject and whose 'measured on' falls in the window that have 'available' true, as a percentage"
    }
  },
  "attesters": {
    "Registrar": {
      "kind": "role",
      "plural": "Registrars"
    },
    "Appraisal Service": {
      "kind": "system",
      "plural": "Appraisal Services",
      "rubrics": {
        "appraisal-v2": {
          "version": 2,
          "claim": "the exhibit's recorded value is consistent with its most recent appraisal",
          "confidence": "the judge's estimate that a second appraisal would agree, from 0 to 1"
        }
      }
    }
  },
  "definitions": [
    "$Fragile Exhibit$ means any $exhibit$ tagged fragile.",
    "$Main Gallery$ refers to exactly one $gallery$ where name is \"Main\"."
  ]
}
